<Window x:Class="RazerProlapse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RazerProlapse"
        Width="320"
        Height="205"
        Background="#18181B"
        Foreground="#F4F4F5"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#22C55E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22C55E"/>
                                <Setter Property="Foreground" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,12,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Centered Live DPI Readout -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock x:Name="DpiValueText"
                       Text="1600"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#22C55E"/>
            <TextBlock Text=" DPI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#71717A"
                       VerticalAlignment="Bottom"
                       Margin="4,0,0,5"/>
        </StackPanel>

        <!-- DPI Slider -->
        <Slider x:Name="DpiSlider"
                Grid.Row="1"
                Minimum="100"
                Maximum="16000"
                Value="1600"
                TickFrequency="50"
                IsSnapToTickEnabled="True"
                Margin="0,0,0,14"
                ValueChanged="DpiSlider_ValueChanged"
                PreviewMouseLeftButtonUp="DpiSlider_PreviewMouseLeftButtonUp"
                KeyUp="DpiSlider_KeyUp"/>

        <!-- Quick-Preset Buttons -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,0,0,10">
            <Button Content="400" Tag="400" Style="{StaticResource PresetButtonStyle}" Margin="0,0,3,0" Click="PresetButton_Click"/>
            <Button Content="800" Tag="800" Style="{StaticResource PresetButtonStyle}" Margin="3,0,3,0" Click="PresetButton_Click"/>
            <Button Content="1600" Tag="1600" Style="{StaticResource PresetButtonStyle}" Margin="3,0,3,0" Click="PresetButton_Click"/>
            <Button Content="3200" Tag="3200" Style="{StaticResource PresetButtonStyle}" Margin="3,0,0,0" Click="PresetButton_Click"/>
        </UniformGrid>

        <!-- Minimal Status Line -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Text="Ready"
                   FontSize="11"
                   Foreground="#71717A"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
